page {
  --ink: #16201c;
  --ink-soft: #35413e;
  --muted: #68736e;
  --line: #c8d0cc;
  --line-soft: #dde3df;
  --line-strong: #aeb9b4;
  --canvas: #f3f5f3;
  --surface: #fcfdfc;
  --surface-soft: #e8eeeb;
  --brand: #0a6b63;
  --brand-dark: #07544e;
  --brand-soft: #eaf4f1;
  --brand-border: #b9d5cf;
  --coral: #a8464e;
  --coral-soft: #faeff0;
  --coral-border: #e5c1c5;
  --gold: #81601d;
  --gold-soft: #f8f2e5;
  --gold-border: #ddcca0;
  --indigo: #4b5b80;
  --indigo-soft: #eff1f7;
  --indigo-border: #c8cedd;
  --price: #8b5c20;
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.custom-nav {
  position: relative;
  z-index: 100;
  width: 100%;
  border-bottom: 1rpx solid #e1e5e3;
  background: #fff;
}

.custom-nav-content {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
}

.nav-brand-lockup {
  display: flex;
  min-width: 0;
  height: 100%;
  align-items: center;
  gap: 16rpx;
}

.nav-brand-logo {
  width: 86rpx;
  height: 86rpx;
  flex: 0 0 86rpx;
}

.nav-brand-slogan {
  width: 210rpx;
  height: 86rpx;
  flex: 0 1 210rpx;
}

view,
text,
scroll-view,
button,
input,
image,
video {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  border-radius: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

.active-card-video {
  display: block;
}

/* Override native button sizing without changing full-width action buttons. */
.media-preview-toggle[size="mini"] {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 8;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  max-width: 88rpx;
  max-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  background: rgba(10, 19, 17, 0.78);
  box-shadow: 0 6rpx 18rpx rgba(5, 12, 10, 0.22);
  transform: translate(-50%, -50%);
}

.media-preview-toggle.playing {
  top: auto;
  bottom: 12rpx;
  left: 12rpx;
  transform: none;
}

.media-preview-toggle-hover {
  background: rgba(7, 84, 78, 0.94);
}

.preview-play-icon {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
  border-left: 23rpx solid #fff;
}

.preview-pause-icon {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.preview-pause-icon view {
  width: 8rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background: #fff;
}

.safe-page {
  min-height: 100vh;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.catalog-utilities { display: flex; justify-content: flex-end; gap: 20px; padding: 4px 16px 0; }
.utility-button[size="mini"] { display: flex; width: auto; min-height: 44px; margin: 0; padding: 0 4px; align-items: center; gap: 8px; color: var(--brand-dark); font-size: 14px; }
.utility-icon { flex: 0 0 20px; width: 20px; height: 20px; }

.page-back-row {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  height: 48px;
  align-items: center;
  padding: 0 16px;
  border-bottom: 1px solid var(--line-soft);
  background: var(--surface);
}

.page-back-button[size="mini"] {
  display: flex;
  width: auto;
  min-height: 44px;
  margin: 0 auto 0 0;
  padding: 0;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  color: var(--brand-dark);
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.page-back-arrow {
  font-size: 24px;
  line-height: 24px;
}

.specimen-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 8px;
}

.specimen-tag {
  max-width: 100%;
  padding: 2px 5px;
  border: 1px solid #cbd8d2;
  border-radius: 4px;
  background: #f0f5f2;
  color: #355449;
  font-size: 11px;
  line-height: 16px;
  white-space: nowrap;
}

.specimen-tag.arrival {
  border-color: #c4d6e8;
  background: #edf4fc;
  color: #315e8b;
}

.specimen-tag.feeding {
  border-color: #b7d9ce;
  background: #eaf6f0;
  color: #1b6650;
}

.specimen-tag.special,
.specimen-tag.sick {
  border-color: #e8c9c5;
  background: #fff1ee;
  color: #9d453c;
}

.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
}

.specimen-number {
  color: #183d72;
  font-size: 13px;
  font-weight: 700;
  line-height: 20px;
  overflow-wrap: anywhere;
}

.specimen-note {
  color: #b43232;
  font-size: 12px;
  line-height: 19px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.price-unit { color: var(--muted); font-size: 11px; font-weight: 400; }

.two-line {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.state-panel {
  margin: 32rpx 28rpx;
  padding: 48rpx 36rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.state-panel.compact {
  margin-top: 24rpx;
}

.empty-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.empty-text {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.primary-button {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  border-radius: 12rpx;
  background: var(--ink);
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
}

.skeleton {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  background: #dde4e1;
}

.skeleton::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.72), transparent);
  content: "";
  transform: translateX(-100%);
  animation: skeleton-sweep 1.35s ease-in-out infinite;
}

@keyframes skeleton-sweep {
  to {
    transform: translateX(100%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton::after {
    animation: none;
  }
}
