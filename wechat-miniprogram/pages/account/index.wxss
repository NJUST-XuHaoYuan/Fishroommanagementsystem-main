.account-identity { padding: 32px 20px 28px; text-align: center; background: var(--surface); }
.account-logo { display: block; width: 80px; height: 80px; margin: 0 auto 20px; }
.account-heading { font-size: 19px; font-weight: 700; line-height: 28px; overflow-wrap: anywhere; }
.account-subtitle { margin-top: 8px; font-size: 13px; color: var(--muted); }
.account-status { margin-top: 8px; color: var(--brand-dark); font-size: 14px; }
.login-form { max-width: 380px; margin: 24px auto 0; }
.login-privacy-link { display: flex; min-height: 44px; align-items: center; justify-content: center; color: var(--brand-dark); font-size: 13px; }
.consent-label { display: flex; min-height: 44px; align-items: center; justify-content: center; gap: 8px; color: var(--ink-soft); font-size: 13px; }
.account-primary { display: flex; width: 100%; min-height: 48px; margin-top: 12px; align-items: center; justify-content: center; border-radius: 6px; background: var(--brand-dark); color: white; font-size: 16px; font-weight: 600; }
.account-primary[disabled] { background: var(--surface-soft); color: var(--muted); }
.account-error { margin-top: 16px; color: #b43232; font-size: 14px; line-height: 22px; text-align: left; }
.account-actions { margin-top: 20px; padding: 0 20px; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); background: var(--surface); }
.account-row { display: flex; width: 100%; min-height: 60px; align-items: center; gap: 12px; border-bottom: 1px solid var(--line-soft); text-align: left; font-size: 15px; }
.account-row:last-child { border-bottom: 0; }
.row-arrow { margin-left: auto; color: var(--muted); font-size: 22px; }
.service-account { justify-content: space-between; padding: 12px 0; }
.service-label { color: var(--muted); font-size: 12px; }
.service-id { color: var(--ink-soft); font-size: 15px; overflow-wrap: anywhere; }
.account-copy[size="mini"] { display: flex; width: auto; min-width: 60px; min-height: 44px; margin: 0; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 4px; color: var(--brand-dark); font-size: 14px; }
.danger-row { color: #b43232; }
