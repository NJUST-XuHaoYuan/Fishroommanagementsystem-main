.specimens-page { background: var(--canvas); }
.species-intro { padding: 16px; border-bottom: 1px solid var(--line-soft); background: var(--surface); }
.species-name { color: var(--ink); font-size: 22px; font-weight: 740; line-height: 30px; overflow-wrap: anywhere; }
.species-scientific { margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 18px; overflow-wrap: anywhere; }
.species-overview, .overview-item { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
.species-overview { margin-top: 14px; gap: 12px; }
.overview-value { font-size: 17px; font-weight: 700; }
.overview-label { color: var(--muted); font-size: 12px; }
.price-overview .overview-value { color: var(--price); }
.overview-divider { width: 1px; height: 14px; background: var(--line); }
.list-toolbar {
  position: sticky;
  top: 48px;
  z-index: 20;
  padding: 14px 16px 12px;
  border-bottom: 1px solid var(--line-soft);
  background: var(--canvas);
}
.list-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.section-title { font-size: 17px; font-weight: 700; }
.section-count { color: var(--muted); font-size: 12px; }
.specimen-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px 12px;
  padding: 16px;
}
.specimen-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--brand-border);
  border-radius: 6px;
  background: var(--surface);
}
.specimen-card-hover { border-color: var(--brand); background: var(--brand-soft); }
.specimen-main { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.specimen-media {
  position: relative;
  width: 100%;
  height: 210rpx;
  flex: 0 0 auto;
  overflow: hidden;
  border-bottom: 1px solid var(--line-soft);
  background: var(--surface-soft);
}
.specimen-image { width: 100%; height: 100%; }
.placeholder { background: var(--surface-soft); }
.specimen-status {
  position: absolute;
  top: 7px;
  right: 7px;
  padding: 3px 6px;
  border: 1px solid var(--brand-border);
  border-radius: 4px;
  background: var(--surface);
  color: var(--brand-dark);
  font-size: 11px;
  font-weight: 700;
  line-height: 16px;
}
.specimen-info { display: flex; min-width: 0; flex: 1; flex-direction: column; padding: 12px 10px; }
.specimen-product { font-size: 16px; font-weight: 700; line-height: 22px; overflow-wrap: anywhere; }
.specimen-spec { margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 18px; overflow-wrap: anywhere; }
.specimen-meta { margin-top: 7px; color: var(--muted); font-size: 11px; line-height: 16px; overflow-wrap: anywhere; }
.specimen-number { margin-top: 8px; }
.specimen-note { margin-top: 4px; }
.specimen-footer { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: auto; padding-top: 14px; }
.specimen-price-stack { min-width: 0; }
.specimen-price { color: var(--price); font-size: 17px; font-weight: 740; line-height: 23px; overflow-wrap: anywhere; }
.specimen-original-price { color: var(--muted); font-size: 11px; text-decoration: line-through; }
.record-arrow { color: var(--brand); font-size: 22px; flex: 0 0 auto; }
.latest-record { padding: 9px 10px; border-top: 1px solid var(--line-soft); }
.record-label { color: var(--brand-dark); font-size: 12px; }
.loading-hero { height: 100px; }
.loading-title { height: 24px; margin-top: 20px; }
.loading-card { height: 220px; margin-top: 20px; }
@media (max-width: 340px) {
  .specimen-list { padding: 12px; gap: 12px 8px; }
  .specimen-info { padding: 10px 8px; }
  .list-toolbar { padding-right: 12px; padding-left: 12px; }
}
