<view class="safe-page specimens-page">
  <view wx:if="{{loading}}" class="state-panel">
    <view class="skeleton loading-hero"></view>
    <view class="skeleton loading-title"></view>
    <view class="skeleton loading-card"></view>
  </view>

  <view wx:elif="{{error}}" class="state-panel">
    <view class="empty-title">可选个体暂时无法加载</view>
    <view class="empty-text">{{error}}</view>
    <button class="primary-button" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:else>
    <view class="species-visual">
      <image wx:if="{{context.image}}" class="context-image" src="{{context.image}}" mode="aspectFit" />
      <view wx:else class="context-image placeholder"></view>
    </view>

    <view class="species-intro">
      <view class="species-name">{{context.name}}</view>
      <view class="species-scientific">{{context.subtitle}}</view>
      <view class="species-overview">
        <view class="overview-item">
          <text class="overview-value">{{context.specimenCount}}</text>
          <text class="overview-label">可选个体</text>
        </view>
        <view class="overview-divider"></view>
        <view class="overview-item price-overview">
          <text class="overview-value">{{context.priceRange}}</text>
          <text class="overview-label">当前售价</text>
        </view>
      </view>
    </view>

    <view class="list-toolbar">
      <view class="list-heading">
        <view class="section-title">选择个体</view>
        <view class="section-count">{{specimens.length}} 条</view>
      </view>
      <view class="filter-row">
        <button
          wx:for="{{filterOptions}}"
          wx:key="key"
          class="filter-option {{activeFilter === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFilterTap"
        >
          {{item.label}}
        </button>
      </view>
    </view>

    <view wx:if="{{specimens.length}}" class="specimen-list">
      <view
        wx:for="{{specimens}}"
        wx:key="id"
        class="specimen-card"
        hover-class="specimen-card-hover"
        role="button"
        aria-label="查看选鱼码{{item.displayCode}}的维护详情"
        data-id="{{item.id}}"
        bindtap="onSpecimenTap"
      >
        <view class="specimen-main">
          <view class="specimen-media">
            <video
              wx:if="{{activePreviewId === item.id}}"
              id="card-video-preview-player"
              class="specimen-image active-card-video"
              src="{{item.previewVideo}}"
              poster="{{item.image}}"
              autoplay="{{true}}"
              muted="{{true}}"
              loop="{{true}}"
              controls="{{false}}"
              show-center-play-btn="{{false}}"
              show-play-btn="{{false}}"
              show-fullscreen-btn="{{false}}"
              enable-progress-gesture="{{false}}"
              object-fit="contain"
              aria-label="选鱼码{{item.displayCode}}的视频预览"
              data-id="{{item.id}}"
              catchtap="onSpecimenTap"
              binderror="onPreviewError"
            />
            <image
              wx:elif="{{item.image}}"
              class="specimen-image"
              src="{{item.image}}"
              mode="aspectFit"
              lazy-load
              data-id="{{item.id}}"
              binderror="onCardImageError"
            />
            <view wx:else class="specimen-image placeholder"></view>
            <button
              wx:if="{{item.hasVideoPreview}}"
              class="media-preview-toggle {{activePreviewId === item.id ? 'playing' : ''}}"
              size="mini"
              hover-class="media-preview-toggle-hover"
              aria-label="{{activePreviewId === item.id ? '暂停' : '播放'}}选鱼码{{item.displayCode}}的视频预览"
              data-id="{{item.id}}"
              data-preview="{{item.previewVideo}}"
              catchtap="onPreviewToggle"
            >
              <view wx:if="{{activePreviewId === item.id}}" class="preview-pause-icon" aria-hidden="true">
                <view></view>
                <view></view>
              </view>
              <view wx:else class="preview-play-icon" aria-hidden="true"></view>
            </button>
            <view class="specimen-status {{item.statusClass}}">{{item.statusText}}</view>
          </view>

          <view class="specimen-info">
            <view class="specimen-top">
              <view class="specimen-code mono">{{item.displayCode}}</view>
              <view class="specimen-price-stack">
                <view wx:if="{{item.isSpecialPrice}}" class="special-price-label">特价</view>
                <view class="specimen-price">{{item.priceText}}</view>
                <view wx:if="{{item.isSpecialPrice}}" class="specimen-original-price">{{item.defaultPriceText}}</view>
              </view>
            </view>
            <view class="specimen-product">{{item.productName}}</view>
            <view class="specimen-attributes">
              <view class="attribute">
                <text class="attribute-label">尺寸</text>
                <text class="attribute-value">{{item.size}}</text>
              </view>
              <view class="attribute">
                <text class="attribute-label">到货</text>
                <text class="attribute-value">{{item.arrivalDate}}</text>
              </view>
            </view>
            <view class="location-row">
              <text class="location-label">缸位</text>
              <text class="location-value">{{item.location}}</text>
            </view>
          </view>
        </view>

        <view class="latest-record">
          <view class="record-copy">
            <text class="record-label">最近维护</text>
            <text class="record-text two-line">{{item.latestBioText}}</text>
          </view>
          <text class="record-arrow">›</text>
        </view>
      </view>
    </view>

    <view wx:else class="state-panel compact">
      <view class="empty-title">当前筛选下没有个体</view>
      <view class="empty-text">可以切换到“全部”继续查看。</view>
    </view>
  </view>
</view>
