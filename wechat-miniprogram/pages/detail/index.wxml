<view class="safe-page detail-page">
  <view class="page-back-row">
    <button class="page-back-button" size="mini" bindtap="onBackTap" aria-label="返回可选库存">
      <text class="page-back-arrow" aria-hidden="true">‹</text><text>返回可选库存</text>
    </button>
  </view>
  <view wx:if="{{loading}}" class="state-panel">
    <view class="skeleton loading-hero"></view>
    <view class="skeleton loading-title"></view>
    <view class="skeleton loading-line"></view>
    <view class="skeleton loading-line short"></view>
  </view>

  <view wx:elif="{{error}}" class="state-panel">
      <view class="empty-title">商品详情暂时无法加载</view>
    <view class="empty-text">{{error}}</view>
    <button class="primary-button" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:else class="detail-content">
    <view class="hero-visual">
      <image
        wx:if="{{specimen.image}}"
        class="hero-image"
        src="{{specimen.image}}"
        mode="aspectFit"
        data-src="{{specimen.image}}"
        bindtap="onPreviewImage"
      />
      <view wx:else class="hero-image placeholder"></view>
    </view>

    <view class="identity-section">
      <view class="identity-top">
        <view class="product-name">{{specimen.productName}}</view>
        <view class="price-stack">
          <view wx:if="{{specimen.isSpecialPrice}}" class="special-price-label">特价</view>
          <view class="price">{{specimen.priceText}}<text class="price-unit"> / {{specimen.unit}}</text></view>
          <view wx:if="{{specimen.isSpecialPrice}}" class="original-price">{{specimen.defaultPriceText}}</view>
        </view>
      </view>
      <view class="stock-quantity">{{members.length > 1 ? '同款可选' : '可选'}} {{members.length || 1}} {{specimen.unit}}</view>
      <view class="taxonomy">
        <text class="species-name">{{specimen.speciesName}}</text>
        <text class="scientific">{{specimen.subtitle}}</text>
      </view>
      <view class="detail-number specimen-number">编号 {{specimen.code || (members.length > 1 ? '未单独编号' : '未设置')}}</view>
      <view wx:if="{{specimen.notes}}" class="detail-note specimen-note">备注：{{specimen.notes}}</view>
      <view class="identity-status">
        <view class="specimen-tags">
          <text wx:for="{{specimen.tags}}" wx:for-item="tag" wx:key="key" class="specimen-tag {{tag.tone}}">{{tag.label}}</text>
        </view>
        <view class="stay-days">到货 {{specimen.daysInStore}} 天</view>
      </view>
    </view>

    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">尺寸</text>
        <text class="info-value">{{specimen.size}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">产地</text>
        <text class="info-value">{{specimen.origin}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">到货日期</text>
        <text class="info-value">{{specimen.arrivalDate}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">当前缸位</text>
        <text class="info-value">{{specimen.location}}</text>
      </view>
    </view>

    <view class="timeline-section">
      <view class="timeline-heading">
        <view>
          <view class="section-title">{{members.length > 1 ? '共同维护记录' : '维护记录'}}</view>
          <view class="section-subtitle">从入库开始持续记录</view>
        </view>
        <view class="timeline-count">{{timeline.length}} 条</view>
      </view>

      <view wx:if="{{timeline.length}}" class="timeline">
        <view wx:for="{{timeline}}" wx:key="id" class="timeline-item">
          <view class="timeline-dot"></view>
          <view class="timeline-content">
            <view class="timeline-top">
              <text class="timeline-title">{{item.title}}</text>
              <text class="timeline-date">{{item.dateText}}</text>
            </view>
            <view class="timeline-text">{{item.text}}</view>
            <view wx:if="{{item.contextText}}" class="timeline-context">{{item.contextText}}</view>
            <view wx:if="{{item.operator}}" class="timeline-context">操作人：{{item.operator}}</view>
            <view wx:if="{{item.mediaSummary}}" class="timeline-media-summary">
              <text>媒体：{{item.mediaSummary}}</text>
              <text wx:if="{{item.mediaUnavailable}}" class="timeline-media-state">原文件待在线加载</text>
            </view>
            <scroll-view wx:if="{{item.photos.length}}" class="photo-scroll" scroll-x enhanced show-scrollbar="{{false}}">
              <image
                wx:for="{{item.photos}}"
                wx:key="*this"
                class="timeline-photo"
                src="{{item}}"
                mode="aspectFit"
                lazy-load
                data-src="{{item}}"
                bindtap="onPreviewImage"
              />
            </scroll-view>
            <view wx:if="{{item.videos.length}}" class="video-list">
              <video
                wx:for="{{item.videos}}"
                wx:key="*this"
                class="timeline-video"
                src="{{item}}"
                controls
                object-fit="contain"
                show-center-play-btn
                show-fullscreen-btn
                enable-progress-gesture
              />
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="state-panel compact">
        <view class="empty-title">暂无公开维护记录</view>
        <view class="empty-text">可联系店员进一步确认。</view>
      </view>
    </view>
  </view>
  <block wx:if="{{!loading && !error && specimen}}">
    <view class="detail-contact-space" aria-hidden="true"></view>
    <button class="detail-contact-button {{refreshing || !contactCard ? 'is-disabled' : ''}}" size="mini" open-type="contact" show-message-card="{{true}}"
      send-message-title="{{contactCard.title}}" send-message-path="{{contactCard.path}}" send-message-img="{{specimen.image || '/assets/brand-logo.jpg'}}"
      disabled="{{refreshing || !contactCard}}" hover-class="contact-button-hover" aria-label="咨询此商品">
      <image class="detail-contact-icon" src="/assets/headset-white.svg" aria-hidden="true" />
      <text class="detail-contact-label" aria-hidden="true">客服</text>
    </button>
  </block>
</view>
