page,
.catalog-page {
  background: #fff;
}

.catalog-page .custom-nav {
  border-bottom: 0;
}

.catalog-service {
  margin: 0 16px;
}

.catalog-service-row {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
}

.catalog-service-label {
  flex: 0 0 auto;
  color: var(--muted);
  font-size: 12px;
}

.catalog-service-id {
  flex: 1;
  min-width: 0;
  color: var(--ink-soft);
  font-size: 13px;
  overflow-wrap: anywhere;
}

.catalog-page .catalog-service-copy {
  flex: 0 0 auto;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0 6px;
  color: var(--brand-dark);
  font-size: 13px;
  font-weight: 600;
  line-height: 44px;
}

.catalog-page .catalog-service-copy-hover {
  background: var(--brand-soft);
}

.major-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 16px 12px 24px;
}

.major-section {
  --group-accent: #00565c;
  --group-tint: #edf8f7;
  --catalog-ink: #202833;
  --catalog-muted: #626d7b;
  --catalog-rule: #e1e6ec;
}

.major-section.coral {
  --group-accent: #a5152d;
  --group-tint: #fff0f3;
}

.major-section.invertebrate {
  --group-accent: #776414;
  --group-tint: #f7f6e9;
}

.major-section.consumable {
  --group-accent: #174b9a;
  --group-tint: #eaf2ff;
}

.major-header {
  display: flex;
  min-height: 48px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 10px;
  background: var(--group-tint);
}

.major-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10px;
}

.major-swatch {
  width: 4px;
  height: 32px;
  flex: 0 0 4px;
  border-radius: 2px;
  background: var(--group-accent);
}

.major-title {
  min-width: 0;
  color: var(--group-accent);
  font-size: 22px;
  font-weight: 700;
  line-height: 30px;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

.major-summary {
  flex: 0 0 auto;
  color: #465261;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
}

.summary-divider {
  padding: 0 4px;
}

.minor-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 16px;
}

.minor-grid.single .minor-link {
  grid-column: 1 / -1;
}

/* Explicit sizing also overrides WeChat's native mini-button defaults. */
.minor-link[size="mini"] {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 56px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 0;
  padding: 10px;
  border: 0;
  border-bottom: 1px solid var(--catalog-rule);
  border-radius: 0;
  background: #fff;
  color: var(--catalog-ink);
  text-align: left;
  white-space: normal;
}

.minor-link[size="mini"].minor-link-hover {
  background: var(--group-tint);
}

.minor-copy {
  min-width: 0;
}

.minor-name {
  color: var(--catalog-ink);
  font-size: 15px;
  font-weight: 600;
  line-height: 21px;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

.minor-meta {
  margin-top: 2px;
  color: var(--catalog-muted);
  font-size: 12px;
  line-height: 17px;
}

.minor-arrow {
  flex: 0 0 auto;
  color: var(--catalog-ink);
  font-size: 23px;
  font-weight: 400;
  line-height: 24px;
}

.catalog-loading {
  padding: 16px 12px 24px;
}

.loading-heading {
  width: 100%;
  height: 48px;
  border-radius: 0;
}

.loading-heading.short {
  margin-top: 16px;
}

.loading-grid {
  height: 300px;
  margin-top: 2px;
  border-radius: 0;
}

.loading-row {
  height: 60px;
  margin-top: 2px;
  border-radius: 0;
}

@media (max-width: 340px) {
  .major-heading {
    gap: 8px;
  }

  .minor-grid {
    column-gap: 8px;
  }

  .minor-link[size="mini"] {
    padding-right: 6px;
    padding-left: 6px;
  }
}


.catalog-search {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 46px;
  margin: 8px 16px 4px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--surface);
}
.catalog-search:focus-within { border-color: var(--brand); }
.catalog-search-icon { position: relative; flex: 0 0 14px; width: 14px; height: 14px; border: 1.5px solid var(--muted); border-radius: 50%; margin-right: 3px; }
.catalog-search-icon::after { position: absolute; right: -5px; bottom: -3px; width: 7px; height: 1.5px; background: var(--muted); content: ""; transform: rotate(45deg); }
.catalog-search-input { flex: 1; min-width: 0; height: 44px; color: var(--ink); font-size: 14px; line-height: 22px; }
.catalog-search-placeholder { color: var(--muted); }
.catalog-page .catalog-search-clear { flex: 0 0 auto; min-width: 44px; min-height: 44px; margin: 0 -8px 0 0; padding: 0 6px; color: var(--brand-dark); font-size: 13px; line-height: 44px; }
.catalog-search-results { padding: 0 16px 24px; }
.search-results-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 12px; padding: 16px 0 8px; }
.search-results-title { font-size: 17px; font-weight: 700; }
.search-results-summary { color: var(--muted); font-size: 12px; }
.catalog-page .search-result { width: 100%; margin: 0; border: 0; border-radius: 0; background: transparent; color: var(--ink); text-align: left; white-space: normal; display: flex; align-items: center; gap: 12px; min-height: 116px; padding: 14px 0; border-bottom: 1px solid var(--line-soft); }
.catalog-page .search-result.search-result-hover { background: var(--brand-soft); }
.search-result-media { display: flex; flex: 0 0 88px; align-items: center; justify-content: center; width: 88px; height: 88px; overflow: hidden; border-radius: 4px; background: var(--surface-soft); }
.search-result-image { width: 100%; height: 100%; }
.search-result-placeholder { color: var(--muted); font-size: 11px; }
.search-result-copy { flex: 1; min-width: 0; }
.search-result-name { color: var(--ink); font-size: 16px; font-weight: 700; line-height: 22px; overflow-wrap: anywhere; }
.search-result-species, .search-result-spec { margin-top: 2px; color: var(--muted); font-size: 12px; line-height: 18px; overflow-wrap: anywhere; }
.search-result-footer { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 8px; margin-top: 6px; }
.search-result-price { color: var(--price); font-size: 16px; font-weight: 700; }
.search-result-price-note { margin-left: 3px; font-size: 11px; }
.search-result-count { color: var(--ink-soft); font-size: 12px; }
.search-result-arrow { flex: 0 0 auto; color: var(--brand); font-size: 22px; line-height: 24px; }
@media (max-width: 340px) {
  .catalog-page .search-result { gap: 9px; }
  .search-result-media { flex-basis: 72px; width: 72px; height: 72px; }
}
