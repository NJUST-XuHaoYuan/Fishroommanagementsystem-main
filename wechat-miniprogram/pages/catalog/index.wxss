page,
.catalog-page {
  background: #fff;
}

.catalog-page .custom-nav {
  border-bottom: 0;
}

.major-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 16px 12px 24px;
}

.major-section {
  --group-accent: #00565c;
  --group-tint: #edf8f7;
  --catalog-ink: #202833;
  --catalog-muted: #626d7b;
  --catalog-rule: #e1e6ec;
}

.major-section.coral {
  --group-accent: #a5152d;
  --group-tint: #fff0f3;
}

.major-section.invertebrate {
  --group-accent: #776414;
  --group-tint: #f7f6e9;
}

.major-section.consumable {
  --group-accent: #174b9a;
  --group-tint: #eaf2ff;
}

.major-header {
  display: flex;
  min-height: 48px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 10px;
  background: var(--group-tint);
}

.major-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10px;
}

.major-swatch {
  width: 4px;
  height: 32px;
  flex: 0 0 4px;
  border-radius: 2px;
  background: var(--group-accent);
}

.major-title {
  min-width: 0;
  color: var(--group-accent);
  font-size: 22px;
  font-weight: 700;
  line-height: 30px;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

.major-summary {
  flex: 0 0 auto;
  color: #465261;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
}

.summary-divider {
  padding: 0 4px;
}

.minor-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 16px;
}

.minor-grid.single .minor-link {
  grid-column: 1 / -1;
}

/* Explicit sizing also overrides WeChat's native mini-button defaults. */
.minor-link[size="mini"] {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 56px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 0;
  padding: 10px;
  border: 0;
  border-bottom: 1px solid var(--catalog-rule);
  border-radius: 0;
  background: #fff;
  color: var(--catalog-ink);
  text-align: left;
  white-space: normal;
}

.minor-link[size="mini"].minor-link-hover {
  background: var(--group-tint);
}

.minor-copy {
  min-width: 0;
}

.minor-name {
  color: var(--catalog-ink);
  font-size: 15px;
  font-weight: 600;
  line-height: 21px;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

.minor-meta {
  margin-top: 2px;
  color: var(--catalog-muted);
  font-size: 12px;
  line-height: 17px;
}

.minor-arrow {
  flex: 0 0 auto;
  color: var(--catalog-ink);
  font-size: 23px;
  font-weight: 400;
  line-height: 24px;
}

.catalog-loading {
  padding: 16px 12px 24px;
}

.loading-heading {
  width: 100%;
  height: 48px;
  border-radius: 0;
}

.loading-heading.short {
  margin-top: 16px;
}

.loading-grid {
  height: 300px;
  margin-top: 2px;
  border-radius: 0;
}

.loading-row {
  height: 60px;
  margin-top: 2px;
  border-radius: 0;
}

@media (max-width: 340px) {
  .major-heading {
    gap: 8px;
  }

  .minor-grid {
    column-gap: 8px;
  }

  .minor-link[size="mini"] {
    padding-right: 6px;
    padding-left: 6px;
  }
}
