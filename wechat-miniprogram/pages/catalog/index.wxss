.catalog-page {
  background: #f4f6f5;
}

.major-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 24rpx 64rpx;
  background: #f4f6f5;
}

.major-section {
  --group-accent: #086b62;
  --group-tint: #e7f3f0;
  --group-border: #b8d8d2;
  overflow: hidden;
  padding: 0;
  border: 1rpx solid var(--group-border);
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 5rpx 16rpx rgba(18, 33, 28, 0.05);
}

.major-section.coral {
  --group-accent: #a13f55;
  --group-tint: #f8e9ed;
  --group-border: #e5bdc6;
}

.major-section.invertebrate {
  --group-accent: #82680d;
  --group-tint: #f7f0dc;
  --group-border: #ddcda0;
}

.major-section.consumable {
  --group-accent: #405a7b;
  --group-tint: #e9eef5;
  --group-border: #bdc8d7;
}

.major-header {
  display: flex;
  min-height: 98rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx 20rpx;
  border-bottom: 3rpx solid var(--group-accent);
  background: var(--group-tint);
}

.major-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
}

.major-swatch {
  width: 8rpx;
  height: 38rpx;
  flex: 0 0 8rpx;
  border-radius: 4rpx;
  background: var(--group-accent);
}

.major-title {
  min-width: 0;
  color: var(--group-accent);
  font-size: 21px;
  font-weight: 700;
  line-height: 28px;
}

.major-summary {
  flex: 0 0 auto;
  color: #4e5b56;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
}

.summary-value {
  color: var(--group-accent);
  font-size: 15px;
  font-weight: 700;
}

.summary-divider {
  padding: 0 10rpx;
  color: #a6aeaa;
}

.minor-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  background: #fff;
}

.minor-grid.single .minor-link {
  grid-column: 1 / -1;
  border-right: 0;
  border-bottom: 0;
}

.minor-link {
  display: flex;
  min-width: 0;
  min-height: 118rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--group-border);
  background: #fff;
  text-align: left;
}

.minor-link:nth-child(odd) {
  border-right: 1rpx solid var(--group-border);
}

.minor-link:nth-child(even) {
  border-right: 0;
}

.minor-link.last-row {
  border-bottom: 0;
}

.minor-link-hover {
  background: var(--group-tint);
}

.minor-copy {
  min-width: 0;
}

.minor-name {
  color: #1e2522;
  font-size: 15px;
  font-weight: 650;
  line-height: 21px;
  word-break: break-all;
}

.minor-meta {
  margin-top: 4rpx;
  color: #68736e;
  font-size: 11px;
  line-height: 16px;
}

.minor-arrow {
  flex: 0 0 auto;
  color: var(--group-accent);
  font-size: 19px;
  font-weight: 600;
  line-height: 20px;
}

.catalog-loading {
  padding: 34rpx 32rpx;
}

.loading-heading {
  width: 100%;
  height: 92rpx;
}

.loading-heading.short {
  margin-top: 30rpx;
}

.loading-grid {
  height: 438rpx;
  margin-top: 2rpx;
  border-radius: 0 0 8rpx 8rpx;
}

.loading-row {
  height: 110rpx;
  margin-top: 2rpx;
  border-radius: 0 0 8rpx 8rpx;
}

@media (max-width: 340px) {
  .major-list {
    gap: 20rpx;
    padding: 20rpx 20rpx 56rpx;
  }

  .major-header {
    min-height: 92rpx;
    gap: 14rpx;
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .minor-link {
    min-height: 110rpx;
    padding-right: 12rpx;
    padding-left: 16rpx;
  }

  .major-title {
    font-size: 19px;
  }

  .major-summary {
    font-size: 10px;
  }

  .summary-value {
    font-size: 13px;
  }
}
