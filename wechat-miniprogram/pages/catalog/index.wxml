<view class="safe-page catalog-page">
  <view
    class="custom-nav"
    style="height: {{navigationHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <view
      class="custom-nav-content"
      style="height: {{navBarHeight}}px; padding-right: {{menuRightPadding}}px;"
    >
      <view class="nav-brand-lockup">
        <image class="nav-brand-logo" src="/assets/brand-logo.jpg" mode="aspectFit" aria-label="海洋森林 Marine Forest" />
        <view class="nav-brand-copy">
          <view class="nav-brand-title-row">
            <text class="nav-brand-name">海洋森林</text>
            <text class="nav-brand-purpose">生物选购</text>
          </view>
          <view class="nav-brand-slogan-row">
            <view class="nav-brand-slogan">
              <image class="nav-brand-slogan-image" src="/assets/brand-slogan-zh.jpg" mode="widthFix" aria-label="种一片海" />
            </view>
            <text class="nav-brand-slogan-en">Grow an Ocean</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showCustomerTools}}" class="catalog-utilities">
    <button class="utility-button" size="mini" open-type="contact" show-message-card="{{true}}" send-message-title="海洋森林 · 生物选购" send-message-path="/pages/catalog/index">
      <image class="utility-icon" src="/assets/message-circle.svg" aria-hidden="true" /><text>咨询客服</text>
    </button>
    <button class="utility-button" size="mini" bindtap="onAccountTap">
      <image class="utility-icon" src="/assets/user-round.svg" aria-hidden="true" /><text>我的</text>
    </button>
  </view>

  <view class="catalog-search">
    <view class="catalog-search-icon" aria-hidden="true"></view>
    <input class="catalog-search-input" value="{{keyword}}" placeholder="搜索名称、俗名或学名"
      placeholder-class="catalog-search-placeholder" aria-label="搜索所有分类的生物名称、俗名、学名、规格或产地"
      maxlength="80" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchInput" />
    <button wx:if="{{keyword}}" class="catalog-search-clear" size="mini" bindtap="onClearSearch" aria-label="清空搜索，返回分类目录">清空</button>
  </view>

  <view class="catalog-site-filter">
    <text class="catalog-site-label">所在地</text>
    <view class="catalog-site-options">
      <button
        wx:for="{{siteOptions}}"
        wx:key="id"
        class="catalog-site-button {{selectedSiteId === item.id ? 'is-selected' : ''}}"
        size="mini"
        hover-class="catalog-site-hover"
        aria-label="只看{{item.id === 'all' ? '全部所在地' : item.label}}的生物{{selectedSiteId === item.id ? '，已选中' : ''}}"
        aria-pressed="{{selectedSiteId === item.id}}"
        data-site-id="{{item.id}}"
        bindtap="onSiteTap"
      >{{item.label}}</button>
    </view>
  </view>

  <view wx:if="{{serviceWechatId}}" class="catalog-service">
    <view class="catalog-service-row">
      <text class="catalog-service-label">客服微信</text>
      <text class="catalog-service-id" user-select="{{true}}">{{serviceWechatId}}</text>
      <button class="catalog-service-copy" size="mini" hover-class="catalog-service-copy-hover"
        disabled="{{copyingServiceWechat}}" aria-label="复制客服微信号 {{serviceWechatId}}"
        bindtap="onCopyServiceWechat">{{copyingServiceWechat ? '复制中' : '复制'}}</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="catalog-loading">
    <view class="skeleton loading-heading"></view>
    <view class="skeleton loading-grid"></view>
    <view class="skeleton loading-heading short"></view>
    <view class="skeleton loading-row"></view>
  </view>

  <view wx:elif="{{error}}" class="state-panel">
    <view class="empty-title">公开鱼单暂时无法加载</view>
    <view class="empty-text">{{error}}</view>
    <button class="primary-button" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{searching}}" class="catalog-search-results">
    <view class="search-results-heading">
      <text class="search-results-title">搜索结果</text>
      <text class="search-results-summary">{{searchProductCount}} 款 · {{selectedSiteId === 'all' ? '全部所在地' : selectedSiteName}}</text>
    </view>
    <view wx:if="{{searchResults.length}}" class="search-result-list">
      <button wx:for="{{searchResults}}" wx:key="id" class="search-result" size="mini" disabled="{{refreshing}}" hover-class="search-result-hover"
        role="button" aria-disabled="{{refreshing}}" aria-label="查看{{item.name}}，{{item.size}}，{{item.specimenCount}}{{item.unit}}可选"
        data-id="{{item.id}}" bindtap="onSearchProductTap">
        <view class="search-result-media">
          <image wx:if="{{item.image}}" class="search-result-image" src="{{item.image}}" mode="aspectFit" lazy-load
            data-id="{{item.id}}" data-src="{{item.image}}" binderror="onSearchImageError" />
          <text wx:else class="search-result-placeholder">暂无图片</text>
        </view>
        <view class="search-result-copy">
          <view class="search-result-name">{{item.name}}</view>
          <view class="search-result-species">{{item.speciesName}}</view>
          <view class="search-result-spec">{{item.size}} · {{item.origin}}</view>
          <view class="search-result-footer">
            <view class="search-result-price">{{item.priceText}}<text wx:if="{{item.priceNote}}" class="search-result-price-note">{{item.priceNote}}</text></view>
            <text class="search-result-count">{{item.specimenCount}} {{item.unit}}可选</text>
          </view>
        </view>
        <text class="search-result-arrow" aria-hidden="true">›</text>
      </button>
    </view>
    <view wx:else class="state-panel compact">
      <view class="empty-title">{{selectedSiteId === 'all' ? '没有找到匹配的生物' : selectedSiteName + '没有匹配的生物'}}</view>
      <view class="empty-text">试试名称中的几个字、俗名或学名{{selectedSiteId === 'all' ? '。' : '，也可以切换上方所在地。'}}</view>
      <button class="primary-button" bindtap="onClearSearch">清空搜索，查看分类</button>
    </view>
  </view>

  <view wx:elif="{{majorGroups.length}}" class="major-list">
    <view
      wx:for="{{majorGroups}}"
      wx:for-item="major"
      wx:key="key"
      class="major-section {{major.tone}}"
    >
      <view class="major-header">
        <view class="major-heading">
          <view class="major-swatch" aria-hidden="true"></view>
          <view class="major-title">{{major.label}}</view>
        </view>
        <view class="major-summary">
          <text class="summary-value">{{major.categoryCount}}</text>
          <text> 小类</text>
          <text class="summary-divider">·</text>
          <text class="summary-value">{{major.specimenCount}}</text>
          <text> {{major.unit}}</text>
        </view>
      </view>

      <view class="minor-grid {{major.categories.length === 1 ? 'single' : ''}}">
        <button
          wx:for="{{major.categories}}"
          wx:for-item="minor"
          wx:key="key"
          class="minor-link"
          size="mini"
          hover-class="minor-link-hover"
          aria-label="查看{{minor.label}}，{{minor.productCount}}款，{{minor.specimenCount}}{{minor.unit}}可选"
          data-category="{{minor.key}}"
          data-major-key="{{major.key}}"
          bindtap="onMinorCategoryTap"
        >
          <view class="minor-copy">
            <view class="minor-name">{{minor.label}}</view>
            <view class="minor-meta">{{minor.productCount}} 款 · {{minor.specimenCount}} {{minor.unit}}</view>
          </view>
          <text class="minor-arrow" aria-hidden="true">›</text>
        </button>
      </view>
    </view>
  </view>

  <view wx:else class="state-panel">
    <view class="empty-title">{{selectedSiteId === 'all' ? '当前没有公开可选商品' : selectedSiteName + '暂无可选生物'}}</view>
    <view class="empty-text">{{selectedSiteId === 'all' ? '下拉刷新后再试。' : '可以切换所在地，看看其他可选生物。'}}</view>
    <button wx:if="{{selectedSiteId !== 'all'}}" class="primary-button" bindtap="onClearSite">查看全部所在地</button>
  </view>
</view>
