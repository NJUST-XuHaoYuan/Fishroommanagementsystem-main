FRONTEND_PORT=8787

# Required. Use one stable absolute host path outside every version directory.
# Keep and back up this same directory across upgrades.
UPLOADS_DIR=/srv/fishroom/uploads

# Required in production. Use a long random value, for example:
# openssl rand -base64 48
AUTH_SESSION_SECRET=replace_with_long_random_session_secret
# Required for field-level encryption of identity and payroll data. Generate a
# 32-byte Base64 key with: openssl rand -base64 32
# Keep previous keys in the map when rotating; only change activeKid after the
# old key remains available to the first upgraded startup.
PERSONNEL_DATA_KEYRING_JSON={"activeKid":"personnel-v1","keys":{"personnel-v1":"replace_with_32_byte_base64_key"}}
# Keep false for public deployments. Set true only when you intentionally allow
# legacy default credentials such as admin/admin.
ALLOW_DEFAULT_CREDENTIALS=false

# Optional customer Mini Program login. Never include AppSecret in the client.
WECHAT_MINIPROGRAM_APP_ID=wxb2bc8f8635f3003b
WECHAT_MINIPROGRAM_APP_SECRET=
# Stable random secret (32+ characters) for pseudonymous customer identities.
# If empty, AUTH_SESSION_SECRET is used. Keep this stable across releases.
WECHAT_MINIPROGRAM_IDENTITY_SECRET=

POSTGRES_DB=fishroom
POSTGRES_USER=fishroom
POSTGRES_PASSWORD=please_change_this_password

# Normally leave DATABASE_URL empty and use PGHOST/PGDATABASE/PGUSER/PGPASSWORD
# from docker-compose.separated.yml. If set, the backend will prefer this URL.
DATABASE_URL=

# Keep video transcoding conservative on the 2-core / 4 GB production host.
VIDEO_TRANSCODE_CONCURRENCY=1
VIDEO_TRANSCODE_MAX_PENDING=2
VIDEO_TRANSCODE_THREADS=1
VIDEO_TRANSCODE_MAX_EDGE=1920
VIDEO_TRANSCODE_PRESET=superfast
VIDEO_UPLOAD_CONCURRENCY=3
VIDEO_UPLOAD_MAX_PENDING=6
# Customer-list previews use their own bounded queue and a tiny silent clip.
VIDEO_PREVIEW_CONCURRENCY=1
VIDEO_PREVIEW_MAX_PENDING=4
VIDEO_PREVIEW_TIMEOUT_MS=120000
VIDEO_PREVIEW_DURATION_SECONDS=4
VIDEO_PREVIEW_MAX_EDGE=480
VIDEO_PREVIEW_FPS=12
VIDEO_PREVIEW_BITRATE_KBPS=450

# AI assistant. AI_API_BASE_URL can point to any OpenAI-compatible API.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# Feishu custom bot webhook for pushing assistant answers from the web app.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Feishu app credentials for replying to Feishu message events.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_DEFAULT_SITE_ID=all
